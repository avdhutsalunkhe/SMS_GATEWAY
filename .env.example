# MongoDB connection (local or MongoDB Atlas free-tier URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sms_gateway

# Secret token that the Android gateway app passes as ?token=... on WS /ws/device
DEVICE_SECRET=replace-with-a-long-random-device-secret

# Optional: auto-seeded "Project 1" API key (leave blank to auto-generate on first startup)
DEFAULT_PROJECT_NAME=Project 1
DEFAULT_PROJECT_API_KEY=

# Optional: if set, /api/v1/admin/* endpoints require X-Admin-Key header
ADMIN_API_KEY=

# Comma-separated CORS origins for local React dashboard
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Worker behavior
SEND_DELAY_SECONDS=4.0
WORKER_POLL_INTERVAL_SECONDS=1.0
MAX_RETRIES=3
